{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "preserve", "strict": true, "noEmit": true,
    "skipLibCheck": true, "isolatedModules": true, "esModuleInterop": true, "resolveJsonModule": true,
    "incremental": true, "allowJs": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
