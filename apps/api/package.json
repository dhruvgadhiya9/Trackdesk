{
  "name": "@trackdesk/api",
  "version": "0.1.0",
  "private": true,
  "description": "Spring Boot API. Turbo calls these scripts so `pnpm turbo run test` covers Java too.",
  "scripts": {
    "dev": "node ../../scripts/gradlew.mjs bootRun --args=--spring.profiles.active=local",
    "build": "node ../../scripts/gradlew.mjs bootJar",
    "lint": "node ../../scripts/gradlew.mjs spotlessCheck",
    "typecheck": "node ../../scripts/gradlew.mjs compileJava compileTestJava",
    "test": "node ../../scripts/gradlew.mjs test",
    "test:isolation": "node ../../scripts/gradlew.mjs isolationTest",
    "db:migrate": "node ../../scripts/gradlew.mjs bootRun --args=--spring.profiles.active=local,migrate-only"
  },
  "dependencies": {
    "@trackdesk/contracts": "workspace:*"
  }
}
