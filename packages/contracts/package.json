{
  "name": "@trackdesk/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./zod": "./src/generated/zod.ts",
    "./permissions": "./src/generated/permissions.ts",
    "./mocks": "./mocks/index.ts"
  },
  "scripts": {
    "generate": "node scripts/bundle-openapi.mjs && orval --config orval.config.ts && node scripts/gen-permissions.mjs && prettier --log-level warn --write src/generated",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "9.9.0",
    "@trackdesk/config": "workspace:*",
    "eslint": "9.39.5",
    "orval": "7.13.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "yaml": "2.8.1"
  }
}
