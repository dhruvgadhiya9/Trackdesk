{
  "_comment": "openapi-generator config for the Java side (apps/api build.gradle.kts -> openApiGenerate). Controllers implement the generated *Api interfaces.",
  "library": "spring-boot",
  "interfaceOnly": true,
  "useSpringBoot3": true,
  "useJakartaEe": true,
  "useBeanValidation": true,
  "performBeanValidation": false,
  "useTags": true,
  "skipDefaultInterface": false,
  "useResponseEntity": true,
  "openApiNullable": false,
  "documentationProvider": "none",
  "annotationLibrary": "none",
  "hideGenerationTimestamp": true,
  "dateLibrary": "java8",
  "sourceFolder": "src/main/java",
  "apiPackage": "com.trackdesk.contracts.api",
  "modelPackage": "com.trackdesk.contracts.model",
  "modelNameSuffix": "Dto",
  "enumUnknownDefaultCase": false,
  "serializableModel": false,
  "requestMappingMode": "none",
  "useSealed": false,
  "generatedConstructorWithRequiredArgs": false
}
